# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# Directory containing model artifacts (pkl files + inference_schema.json)
MODEL_DIR=model

# Comma-separated list of allowed CORS origins. Use * to allow all.
CORS_ORIGINS=*

# Maximum number of items allowed in a single /predict/batch request
BATCH_LIMIT=500

# Port exposed by docker-compose (default 8000)
PORT=8000
